# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=todo_password
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_TIMEOUT=30

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Environment
ENV=development

# Telegram Alerts (Optional - for ERROR/WARN log notifications)
# Get bot token from @BotFather, group ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_GROUP_ID=your_group_id_here
# Optional: Thread ID for topic groups
# TELEGRAM_THREAD_ID=305
