# Production Environment Configuration
# Copy this file to .env.prod and fill in real values
# DO NOT commit .env.prod to version control!

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=todo_db_prod
DB_USER=todo_user_prod
DB_PASSWORD=change_this_to_strong_random_password
DB_SSLMODE=require

# Server Configuration
SERVER_PORT=8090          # Prod API port (default: 8090, different from dev 8080)
SERVER_TIMEOUT=30
# API_BASE_URL=http://localhost:8090  # Change when you have a domain (e.g., https://api.yourdomain.com)

# JWT Configuration
# Use a strong random string (at least 32 characters)
JWT_SECRET=your-super-secure-production-jwt-secret-min-32-chars

# Environment
ENV=production

# Telegram Alerts (Optional - for ERROR/WARN log notifications)
# Get bot token from @BotFather, group ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Optional: Thread ID for topic groups
# TELEGRAM_THREAD_ID=
